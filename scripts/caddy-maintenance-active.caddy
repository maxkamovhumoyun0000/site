handle /api/platform-maintenance {
	respond `{"active":true,"ends_at":"__MAINTENANCE_ENDS_AT__","message_uz":"Texnik ishlar olib borilmoqda. Taxminan 30 daqiqa ichida qaytamiz.","message_ru":"Проводятся технические работы. Ориентировочно вернёмся через 30 минут.","message_en":"Technical work is in progress. We expect to be back in about 30 minutes."}` 200
}

handle /api/app-version-check {
	respond `{"force_update":false,"maintenance":{"enabled":true,"active":true,"starts_at":"","ends_at":"__MAINTENANCE_ENDS_AT__","message_uz":"Texnik ishlar olib borilmoqda. Taxminan 30 daqiqa ichida qaytamiz.","message_ru":"Проводятся технические работы. Ориентировочно вернёмся через 30 минут.","message_en":"Technical work is in progress. We expect to be back in about 30 minutes."}}` 200
}

handle {
	root * /var/www
	rewrite * /diamond-site-maintenance.html
	file_server
}
